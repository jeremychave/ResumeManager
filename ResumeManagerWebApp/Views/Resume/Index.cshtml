@using ResumeManagerWebApp.Models
@model List<Resume>

<h2>This is the Resume page</h2>

<h1>My resume</h1>
<table class="table">
    <thead>
        <tr>
            <th>File name</th>
            <th>Size</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Name</td>
                <td>@r.Size</td>
            </tr>
        }
    </tbody>
</table>