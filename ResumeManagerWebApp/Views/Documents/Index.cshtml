@using ResumeManagerWebApp.Models
@model List<Document>

<h1>My documents</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@Html.Raw(@TempData["Message"])</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
}

<div>
    <a class="btn btn-primary" asp-controller="Documents" asp-action="Upload">
        Upload new document
    </a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>File name</th>
            <th>Size</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Name</td>
                <td>@r.Size</td>
            </tr>
        }
    </tbody>
</table>