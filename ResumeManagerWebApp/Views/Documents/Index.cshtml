@using ResumeManagerWebApp.Models
@model List<Document>

<h1>My documents</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@Html.Raw(@TempData["Message"])</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@Html.Raw(TempData["Error"])</div>
}

<div>
    <a class="btn btn-primary" asp-controller="Documents" asp-action="Upload">
        Upload new document
    </a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>File name</th>
            <th>Size</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.FileName</td>
                <td>@r.Size</td>
                <td>
                    <div>
                        <form asp-controller="Documents" asp-action="Download" method="get" style="display:inline;">
                            <input type="hidden" name="fileName" value="@r.FileName" />
                            <button type="submit" class="btn btn-secondary btn-sm">
                                <i class="bi bi-download"></i>
                            </button>
                        </form>

                        <form asp-controller="Documents" asp-action="Delete" method="post" style="display:inline;">
                            <input type="hidden" name="blobName" value="@r.BlobName" />
                            <button type="submit" class="btn btn-danger btn-sm"
                                    onclick="return confirm('Delete this document?');">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>