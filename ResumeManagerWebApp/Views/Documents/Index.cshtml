@using ResumeManagerWebApp.Models
@model List<Document>

<h1>My documents</h1>

<div>
    <a class="btn btn-primary" asp-controller="Documents" asp-action="Upload">
        Upload new document
    </a>
</div>
<table class="table">
    <thead>
        <tr>
            <th>File name</th>
            <th>Size</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Name</td>
                <td>@r.Size</td>
            </tr>
        }
    </tbody>
</table>