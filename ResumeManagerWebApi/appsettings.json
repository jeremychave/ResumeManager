{
  "KeyVaultUrl": "https://resumemanagerkeyvault.vault.azure.net/",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureStorage": {
    "BlobServiceUrl": "https://resumemanagerblobstorage.blob.core.windows.net/",
    "ContainerName": "documents"
  },
  "ApiSettings": {
    "ResumeManagerApiKey": "@Microsoft.KeyVault(SecretUri=https://resumemanagerkeyvault.vault.azure.net/secrets/resume-manager-api-key/)",
    "SignatureSecret": "@Microsoft.KeyVault(SecretUri=https://resumemanagerkeyvault.vault.azure.net/secrets/resume-manager-signature-secret/)"
  }
}
